export DIRENV_WARN_TIMEOUT=20s

# `zig` here is the anyzig shim, and with no `ZIG_GLOBAL_CACHE_DIR` it puts the
# whole build cache in the project directory. A project that runs a few hundred
# builds leaves several gigabytes there, and deleting it takes minutes over NFS.
# `devenv.nix` sets the same variable for `devenv shell`; this line is what
# covers an ordinary direnv shell and a bare `zig build` in a tool that does
# not load this file. The root has to exist with a `p` symlink to the shared
# toolchain store or the shim re-downloads 0.16.0 on every invocation.
export ZIG_GLOBAL_CACHE_DIR="${ZIG_GLOBAL_CACHE_DIR:-/tmp/zig-caches/ozai}"
mkdir -p "$ZIG_GLOBAL_CACHE_DIR"
[ -e "$ZIG_GLOBAL_CACHE_DIR/p" ] || ln -s /tmp/zig-global-cache/p "$ZIG_GLOBAL_CACHE_DIR/p"

eval "$(devenv direnvrc)"

# `use devenv` supports the same options as the `devenv shell` command.
#
# To silence the output, use `--quiet`.
#
# Example usage: use devenv --quiet --impure --option services.postgres.enable:bool true
use devenv
