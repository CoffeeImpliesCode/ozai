export DIRENV_WARN_TIMEOUT=20s

# Two caches, and they are not the same thing. `ZIG_GLOBAL_CACHE_DIR` is the
# per-project build cache, and it wants a `p` subdirectory or the anyzig shim
# re-downloads 0.16.0 on every call. That `p` is a symlink to the one shared
# store at `/tmp/zig-global-cache/p`, so build caches stay
# per-project while downloaded toolchains stay shared. It lives on `/home/tmp2`.
export ZIG_GLOBAL_CACHE_DIR="${ZIG_GLOBAL_CACHE_DIR:-/tmp/zig-caches/ozai}"
mkdir -p "$ZIG_GLOBAL_CACHE_DIR"
[ -e "$ZIG_GLOBAL_CACHE_DIR/p" ] || ln -s /tmp/zig-global-cache/p "$ZIG_GLOBAL_CACHE_DIR/p"

# The *local* cache is the other one, and it is where the 14 GiB went. Zig
# keys it on a hash of the build graph, so every configuration gets its own
# tree and nothing is ever compacted: Debug, ReleaseSafe, `-Dcoverage=true`
# (which forces the LLVM backend), and every fuzz target and test artifact on
# top of those, each keyed differently, all coexist. It follows `--cache-dir`,
# not `ZIG_GLOBAL_CACHE_DIR`, so it defaults to the project directory — on the
# NFS export, not on local disk. Here it goes to `/home/tmp2` with the rest of
# the scratch.
#
# Do not "clean up" by deleting it. Deleting it forces a full rebuild, and the
# rebuild writes a fresh tree alongside every surviving configuration, so it
# comes back larger than it left. `zig build --help` lists the prune flag; use
# that, or `rm -rf` only when the project is finished with.
export ZIG_LOCAL_CACHE_DIR="${ZIG_LOCAL_CACHE_DIR:-/tmp/cache/ozai/.zig-cache}"
mkdir -p "$ZIG_LOCAL_CACHE_DIR"

# Verified: `zig build` reads this variable directly, so no alias and no extra
# flag is needed. Where the local cache actually lands is conditional on this
# file being loaded, though: a build that does not load it — a bare `zig build`
# in a fresh shell, a CI step, an editor's language server — falls back to a
# `.zig-cache` in the project directory, which is the NFS write path the rest of
# this file exists to keep builds off.

# `/tmp` here is `/dev/mapper/vg0-tmp` — 9.8 GiB, node-local, and not for bulk
# data. Rechnerbetriebsgruppe asked that scratch go to the volumes provided for
# it: `/vol/tmp` and `/vol/tmp2` on every buildhost, `/home/tmp` and `/home/tmp2`
# on those that have them. Checked with `lsblk` and `df -hT`: this node has
# `/home/tmp` (1.0 TiB, 872 GiB free), `/home/tmp2` (12 TiB, empty),
# `/vol/tmp` (140 TiB, 47 TiB free) and `/vol/tmp2` (140 TiB, 60 TiB free).
# Build scratch goes to `/home/tmp2` — local disk, so the thousands of small
# files a Zig build produces do not pay NFS latency.
export TMPDIR="${TMPDIR:-/tmp/scratch/ozai}"
mkdir -p "$TMPDIR"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/cache}"
mkdir -p "$XDG_CACHE_HOME"

eval "$(devenv direnvrc)"

# `use devenv` supports the same options as the `devenv shell` command.
#
# To silence the output, use `--quiet`.
#
# Example usage: use devenv --quiet --impure --option services.postgres.enable:bool true
use devenv
